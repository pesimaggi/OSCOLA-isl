<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" demote-non-dropping-particle="never" default-locale="is">
  <info>
    <title>OSCOLA - Íslenska</title>
    <title-short>OSCOLA</title-short>
    <id>http://www.zotero.org/styles/oscola_isl-2</id>
    <link href="http://www.zotero.org/styles/oscola_isl-2" rel="self"/>
    <link href="http://www.zotero.org/styles/oscola" rel="template"/>
    <link href="https://bokasafn.ru.is/oscola/oscolaheild" rel="documentation"/>
    <link href="https://www.law.ox.ac.uk/sites/default/files/migrated/oscola_4th_edn_hart_2012.pdf" rel="documentation"/>
    <author>
      <name>Sebastian Karcher</name>
    </author>
    <contributor>
      <name>Thora Gylfadottir (Reykjavik University)</name>
    </contributor>
    <contributor>
      <name>Ragna Bjork Kristjansdottir (Reykjavik University)</name>
    </contributor>
    <category citation-format="note"/>
    <category field="law"/>
    <summary>OSCOLA (4. útg.) með íslenskri aðlögun samkvæmt leiðbeiningum Bókasafns Háskólans í Reykjavík (https://bokasafn.ru.is/oscola). Íslensk höfundanöfn skal skrá í eitt svið („single field“) í Zotero svo þau birtist óbreytt; erlend nöfn í tvö svið. Frumheimildir (Case, Statute, Bill) eru skráðar í heild sinni í titilsviðið.</summary>
    <updated>2026-10-21T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="is">
    <style-options punctuation-in-quote="false"/>
    <date form="text">
      <date-part name="day" suffix=". "/>
      <date-part name="month" suffix=" "/>
      <date-part name="year"/>
    </date>
    <terms>
      <term name="et-al">o.fl.</term>
      <term name="and">og</term>
      <term name="no date"/>
      <term name="in">í</term>
      <term name="ibid">sama heimild</term>
      <term name="accessed">skoðað</term>
      <term name="open-quote">„</term>
      <term name="close-quote">“</term>
      <term name="open-inner-quote">‚</term>
      <term name="close-inner-quote">‘</term>
      <term name="ordinal">.</term>
      <term name="edition" form="short">útg.</term>
      <term name="editor" form="short">
        <single>ritstj.</single>
        <multiple>ritstj.</multiple>
      </term>
      <term name="translator" form="short">
        <single>þýð.</single>
        <multiple>þýð.</multiple>
      </term>
      <term name="editortranslator" form="short">
        <single>ritstj. og þýð.</single>
        <multiple>ritstj. og þýð.</multiple>
      </term>
      <!-- Pinpoint labels, following the RU translation table (Íslenskur ritháttur) -->
      <term name="chapter" form="short">
        <single>kafli</single>
        <multiple>kafli</multiple>
      </term>
      <term name="column" form="short">
        <single>dálkur</single>
        <multiple>dálkar</multiple>
      </term>
      <term name="paragraph" form="short">
        <single>mgr.</single>
        <multiple>mgr.</multiple>
      </term>
      <term name="note" form="short">
        <single>n.</single>
        <multiple>nn.</multiple>
      </term>
      <term name="volume" form="short">
        <single>b.</single>
        <multiple>b.</multiple>
      </term>
      <term name="figure" form="short">
        <single>mynd</single>
        <multiple>myndir</multiple>
      </term>
    </terms>
  </locale>
  <!-- Primary sources: everything (incl. italics via <i>) is entered in the
       title field ("Case Name", "Name of Act", "Title"), so only the title is printed. -->
  <macro name="primary-source">
    <text variable="title"/>
  </macro>
  <!-- Authors and persons -->
  <macro name="author-note">
    <choose>
      <if type="broadcast">
        <text variable="publisher"/>
      </if>
      <else>
        <names variable="author">
          <name and="text" delimiter=", " delimiter-precedes-last="never" initialize="false" initialize-with=""/>
          <label form="short" prefix=" (" suffix=")"/>
          <substitute>
            <names variable="editor"/>
            <names variable="translator"/>
            <text macro="title"/>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>
  <macro name="author-short">
    <choose>
      <if type="broadcast">
        <text variable="publisher"/>
      </if>
      <else>
        <names variable="author">
          <name form="short" and="text" delimiter=", " delimiter-precedes-last="never" initialize="false" initialize-with=""/>
          <substitute>
            <names variable="editor"/>
            <names variable="translator"/>
            <text macro="title-short"/>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>
  <!-- Bibliography: foreign names "Surname Initials" (two-field names);
       Icelandic names entered as a single field are printed unchanged. -->
  <macro name="author">
    <choose>
      <if type="broadcast">
        <text variable="publisher"/>
      </if>
      <else>
        <names variable="author">
          <name and="text" delimiter=", " delimiter-precedes-last="never" name-as-sort-order="all" sort-separator=" " initialize-with=""/>
          <label form="short" prefix=" (" suffix=")"/>
          <substitute>
            <names variable="editor"/>
            <names variable="translator"/>
            <text macro="title"/>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>
  <macro name="editor">
    <names variable="editor translator" delimiter=", ">
      <name and="text" delimiter=", " delimiter-precedes-last="never" initialize="false" initialize-with=""/>
      <label form="short" prefix=" "/>
    </names>
  </macro>
  <macro name="editor-chapter">
    <choose>
      <if type="chapter paper-conference" match="any">
        <group delimiter=" ">
          <text term="in"/>
          <names variable="editor translator" delimiter=", ">
            <name and="text" delimiter=", " delimiter-precedes-last="never" initialize="false" initialize-with=""/>
            <label form="short" prefix=" (" suffix=")"/>
          </names>
        </group>
      </if>
    </choose>
  </macro>
  <!-- Titles: no automatic case changes, titles are printed as entered -->
  <macro name="title">
    <choose>
      <if type="book motion_picture manuscript broadcast" match="any">
        <text variable="title" font-style="italic"/>
      </if>
      <else-if type="legal_case legislation bill treaty interview personal_communication" match="any">
        <text variable="title"/>
      </else-if>
      <else>
        <text variable="title" quotes="true"/>
      </else>
    </choose>
  </macro>
  <macro name="title-short">
    <choose>
      <if type="book motion_picture manuscript broadcast" match="any">
        <text variable="title" form="short" font-style="italic"/>
      </if>
      <else-if type="legal_case legislation bill treaty interview personal_communication" match="any">
        <text variable="title" form="short"/>
      </else-if>
      <else>
        <text variable="title" form="short" quotes="true"/>
      </else>
    </choose>
  </macro>
  <macro name="container">
    <choose>
      <if type="chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
        <text variable="container-title" font-style="italic"/>
      </if>
      <else-if type="broadcast">
        <text variable="container-title" font-style="italic"/>
      </else-if>
    </choose>
  </macro>
  <!-- "„Title“ í Ritstjóri (ritstj.), Container" / "„Title“, Container" -->
  <macro name="title-block">
    <group delimiter=", ">
      <group delimiter=" ">
        <text macro="title"/>
        <text macro="editor-chapter"/>
      </group>
      <text macro="container"/>
      <text macro="volume-book"/>
    </group>
  </macro>
  <macro name="volume-book">
    <choose>
      <if type="book" match="any">
        <group delimiter=" ">
          <label variable="volume" form="short"/>
          <text variable="volume"/>
        </group>
      </if>
    </choose>
  </macro>
  <!-- Dates -->
  <macro name="issued-year">
    <date variable="issued" form="text" date-parts="year"/>
  </macro>
  <macro name="issued-full">
    <date variable="issued" form="text"/>
  </macro>
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <label variable="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <!-- Journals, magazines and newspapers: "(2010) 7 Tímarit Lögréttu" / "[2015] Úlfljótur" / "Fréttablaðið" -->
  <macro name="periodical">
    <choose>
      <if type="article-journal article-magazine" match="any">
        <group delimiter=" ">
          <choose>
            <if variable="volume">
              <text macro="issued-year" prefix="(" suffix=")"/>
              <group>
                <text variable="volume"/>
                <text variable="issue" prefix="(" suffix=")"/>
              </group>
            </if>
            <else>
              <text macro="issued-year" prefix="[" suffix="]"/>
            </else>
          </choose>
          <choose>
            <if type="article-magazine">
              <text variable="container-title" font-style="italic"/>
            </if>
            <else>
              <text variable="container-title"/>
            </else>
          </choose>
        </group>
      </if>
      <else-if type="article-newspaper">
        <text variable="container-title" font-style="italic"/>
      </else-if>
    </choose>
  </macro>
  <!-- Publication details in parentheses -->
  <macro name="publisher">
    <choose>
      <if type="article-journal article-magazine" match="any"/>
      <else-if type="article-newspaper">
        <group delimiter=", " prefix="(" suffix=")">
          <text variable="publisher-place"/>
          <text macro="issued-full"/>
        </group>
      </else-if>
      <else-if type="webpage post-weblog post" match="any">
        <group delimiter=", " prefix="(" suffix=")">
          <choose>
            <if variable="container-title">
              <text variable="container-title" font-style="italic"/>
            </if>
            <else>
              <text variable="publisher" font-style="italic"/>
            </else>
          </choose>
          <text macro="issued-full"/>
        </group>
      </else-if>
      <else-if type="speech">
        <group delimiter=", " prefix="(" suffix=")">
          <choose>
            <if variable="event-title">
              <text variable="event-title"/>
            </if>
            <else>
              <text variable="event"/>
            </else>
          </choose>
          <text variable="event-place"/>
          <text macro="issued-full"/>
        </group>
      </else-if>
      <else-if type="interview personal_communication" match="any">
        <group delimiter=" " prefix="(" suffix=")">
          <text variable="publisher-place"/>
          <text macro="issued-full"/>
        </group>
      </else-if>
      <else-if type="broadcast manuscript" match="any">
        <text macro="issued-full" prefix="(" suffix=")"/>
      </else-if>
      <else-if type="motion_picture">
        <group delimiter=", " prefix="(" suffix=")">
          <names variable="director">
            <name and="text" delimiter=", " delimiter-precedes-last="never" initialize="false" initialize-with=""/>
          </names>
          <text variable="publisher"/>
          <text macro="issued-year"/>
        </group>
      </else-if>
      <else-if type="thesis">
        <group delimiter=", " prefix="(" suffix=")">
          <text variable="genre"/>
          <group delimiter=" ">
            <text variable="publisher"/>
            <text macro="issued-year"/>
          </group>
        </group>
      </else-if>
      <else-if type="book chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
        <group delimiter=", " prefix="(" suffix=")">
          <choose>
            <if type="book">
              <text macro="editor"/>
            </if>
          </choose>
          <text macro="edition"/>
          <group delimiter=" ">
            <text variable="publisher"/>
            <text macro="issued-year"/>
          </group>
        </group>
      </else-if>
      <else>
        <!-- report and all other "other secondary sources" -->
        <group delimiter=" ">
          <group delimiter=", " prefix="(" suffix=")">
            <text macro="editor"/>
            <text macro="edition"/>
            <group delimiter=" ">
              <text variable="publisher"/>
              <text macro="issued-full"/>
            </group>
          </group>
          <group delimiter=" ">
            <text variable="genre"/>
            <text variable="number"/>
          </group>
        </group>
      </else>
    </choose>
  </macro>
  <!-- First page of journal articles and encyclopedia entries -->
  <macro name="page-first">
    <choose>
      <if type="article-journal article-magazine entry-encyclopedia entry-dictionary" match="any">
        <text variable="page-first"/>
      </if>
    </choose>
  </macro>
  <macro name="page-first-note">
    <choose>
      <if type="article-journal article-magazine article-newspaper entry-encyclopedia entry-dictionary" match="any">
        <text variable="page-first"/>
      </if>
    </choose>
  </macro>
  <!-- Pinpoint: page numbers without a label, everything else with an Icelandic label (mgr. 1, kafli 2) -->
  <macro name="locator">
    <group delimiter=" ">
      <choose>
        <if locator="page" match="none">
          <label variable="locator" form="short"/>
        </if>
      </choose>
      <text variable="locator"/>
    </group>
  </macro>
  <macro name="pinpoint">
    <group delimiter=", ">
      <text macro="page-first-note"/>
      <text macro="locator"/>
    </group>
  </macro>
  <macro name="URL">
    <choose>
      <if variable="URL">
        <group delimiter=" ">
          <text variable="URL" prefix="&lt;" suffix="&gt;"/>
          <group delimiter=" ">
            <text term="accessed"/>
            <date variable="accessed" form="text"/>
          </group>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="reference-note">
    <group delimiter=" ">
      <group delimiter=", ">
        <text macro="author-note"/>
        <text macro="title-block"/>
      </group>
      <text macro="periodical"/>
      <text macro="publisher"/>
      <text macro="pinpoint"/>
      <text macro="URL"/>
    </group>
  </macro>
  <macro name="reference-bib">
    <group delimiter=" ">
      <group delimiter=", ">
        <text macro="author"/>
        <text macro="title-block"/>
      </group>
      <text macro="periodical"/>
      <text macro="publisher"/>
      <text macro="page-first"/>
      <text macro="URL"/>
    </group>
  </macro>
  <!-- Sorting: secondary sources first, then primary sources grouped by type
       (lög og reglugerðir, Alþingistíðindi, þjóðréttarsamningar, dómar og úrskurðir) -->
  <macro name="author-count">
    <names variable="author">
      <name form="count"/>
      <substitute>
        <names variable="editor"/>
      </substitute>
    </names>
  </macro>
  <macro name="sort-type">
    <choose>
      <if type="legislation">
        <text value="2"/>
      </if>
      <else-if type="bill">
        <text value="3"/>
      </else-if>
      <else-if type="treaty">
        <text value="4"/>
      </else-if>
      <else-if type="legal_case">
        <text value="5"/>
      </else-if>
      <else>
        <text value="1"/>
      </else>
    </choose>
  </macro>
  <macro name="sort-primary-title">
    <choose>
      <if type="legal_case legislation bill treaty" match="any">
        <text variable="title"/>
      </if>
    </choose>
  </macro>
  <citation et-al-min="4" et-al-use-first="1">
    <layout suffix="." delimiter="; ">
      <choose>
        <if position="ibid-with-locator">
          <group delimiter=" ">
            <text term="ibid"/>
            <choose>
              <if type="legal_case legislation bill treaty" match="any">
                <text variable="locator"/>
              </if>
              <else>
                <text macro="locator"/>
              </else>
            </choose>
          </group>
        </if>
        <else-if position="ibid">
          <text term="ibid"/>
        </else-if>
        <else-if type="legal_case legislation bill treaty" match="any">
          <!-- primary sources are always cited in full (or by a nickname added in the suffix) -->
          <group delimiter=", ">
            <text macro="primary-source"/>
            <text variable="locator"/>
          </group>
        </else-if>
        <else-if position="subsequent">
          <group delimiter=" ">
            <group delimiter=", ">
              <text macro="author-short"/>
              <choose>
                <if disambiguate="true">
                  <text macro="title-short"/>
                </if>
              </choose>
            </group>
            <text variable="first-reference-note-number" prefix="(n. " suffix=")"/>
            <text macro="locator"/>
          </group>
        </else-if>
        <else>
          <text macro="reference-note"/>
        </else>
      </choose>
    </layout>
  </citation>
  <bibliography et-al-min="4" et-al-use-first="1" subsequent-author-substitute="——" subsequent-author-substitute-rule="partial-first">
    <sort>
      <key macro="sort-type"/>
      <key macro="sort-primary-title"/>
      <key macro="author" names-min="1" names-use-first="1"/>
      <key macro="author-count" names-min="3" names-use-first="3"/>
      <key macro="author" names-min="3" names-use-first="3"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>
    <layout>
      <choose>
        <if type="legal_case legislation bill treaty" match="any">
          <text macro="primary-source"/>
        </if>
        <else>
          <text macro="reference-bib"/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
